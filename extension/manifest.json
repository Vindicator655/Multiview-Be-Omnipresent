{
  "manifest_version": 3,
  "name": "Multiview — Be Omnipresent",
  "short_name": "Multiview",
  "version": "1.0.0",
  "description": "Watch 4, 9 or 16 YouTube live streams and other feeds at once in a 16:9 video wall, with labels and an observation log.",
  "homepage_url": "https://github.com/Vindicator655/Multiview-Be-Omnipresent",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "contextMenus"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*",
    "https://example.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["viewer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/watch*", "*://www.youtube.com/live/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Multiview",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open Multiview"
    }
  }
}
